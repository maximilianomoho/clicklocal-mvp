<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClickLocal Paraná</title>
  <link rel="stylesheet" href="/styles.css" />

<style>
  .respuesta-buscador {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 22px;
    padding: 22px;
    margin-bottom: 22px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  }

  .respuesta-buscador h2 {
    margin-bottom: 8px;
  }

  .respuesta-buscador p {
    margin: 0;
    color: #64748b;
    line-height: 1.5;
  }

  .grilla-comercios-lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .comercio-lista-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 22px;
    padding: 20px;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
  }

  .comercio-lista-premium {
    border: 1px solid #f59e0b;
  }

  .comercio-lista-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
  }

  .comercio-lista-top h3 {
    margin: 4px 0 0;
  }

  .badge-premium {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 6px 10px;
    background: #fff7ed;
    color: #c2410c;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .coincide-lista {
    background: #f8fafc;
    border-left: 4px solid #0ea5e9;
    border-radius: 14px;
    padding: 12px 14px;
    margin: 12px 0;
    color: #334155;
  }

  .coincide-lista p {
    margin: 0 0 6px;
  }

  .coincide-lista p:last-child {
    margin-bottom: 0;
    color: #64748b;
    font-size: 14px;
  }

  .acciones-lista {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
  }
</style>

</head>

<body>

  <header class="header">
    <div class="header-contenedor">

      <div class="logo-zona">
        <div class="logo-circulo">C</div>

        <div>
          <h1 class="logo-texto">ClickLocal</h1>
          <p class="ciudad">📍 Paraná</p>
        </div>
      </div>

      <nav class="nav">
        {% if session.get("user_id") and session.get("comercio") %}
          <span class="nav-link">👤 {{ session.get("comercio").get("nombre_negocio") or session.get("comercio").get("nombre") or "Mi comercio" }}</span>
          <a href="/panel" class="boton-secundario">Mi panel</a>
          <a href="/logout" class="boton-secundario">Cerrar sesión</a>
        {% else %}
          <a href="/login.html" class="boton-secundario">Iniciar sesión</a>
        {% endif %}
      </nav>

    </div>
  </header>


  <section class="hero">
    <div class="hero-contenedor">

      <p class="etiqueta-hero">La vidriera digital de tu ciudad</p>

      <h2 class="titulo-hero">
        Encontrá lo que buscás,<br />
        cerca tuyo.
      </h2>

      <p class="subtitulo-hero">
        Productos, comercios, emprendimientos y servicios de Paraná en un solo lugar.
      </p>

      <form class="buscador" method="GET" action="/index.html">
        <input
          class="input-busqueda"
          type="text"
          name="q"
          value="{{ busqueda or '' }}"
          placeholder="Buscar: mate, hamburguesa, zapatillas, electricista..."
        />

        <button class="boton-buscar" type="submit">
          Buscar
        </button>
      </form>

      <div class="busquedas-rapidas">
        <a href="/index.html?q=hamburguesa">Hamburguesas</a>
        <a href="/index.html?q=mate">Mates</a>
        <a href="/index.html?q=zapatilla">Zapatillas</a>
        <a href="/index.html?q=electricista">Electricista</a>
        <a href="/index.html?q=curso">Cursos</a>
      </div>

    </div>
  </section>


  <main>

    <!-- CATEGORÍAS -->
    <section class="seccion categorias">
      <div class="contenedor">

        <p class="titulo-chico">CATEGORÍAS</p>
        <h2 class="titulo-seccion">Explorá por rubro</h2>

        <div class="grilla-categorias">

          <a href="#" class="categoria-card">
            <span class="categoria-icono">🍔</span>
            Gastronomía
          </a>

          <a href="#" class="categoria-card">
            <span class="categoria-icono">👕</span>
            Indumentaria
          </a>

          <a href="#" class="categoria-card">
            <span class="categoria-icono">🏠</span>
            Hogar
          </a>

          <a href="#" class="categoria-card">
            <span class="categoria-icono">💻</span>
            Tecnología
          </a>

          <a href="#" class="categoria-card">
            <span class="categoria-icono">💊</span>
            Salud
          </a>

          <a href="#" class="categoria-card">
            <span class="categoria-icono">🛠️</span>
            Servicios
          </a>

          <a href="#" class="categoria-card">
            <span class="categoria-icono">⚽</span>
            Deportes
          </a>

          <a href="#" class="categoria-card">
            <span class="categoria-icono">📚</span>
            Educación
          </a>

        </div>

      </div>
    </section>


    <!-- LO MÁS VISTO -->
    <section class="seccion">
      <div class="contenedor">

        <p class="titulo-chico">DESTACADOS</p>
        <h2 class="titulo-seccion">
          {% if busqueda %}
            Resultados para "{{ busqueda }}"
          {% else %}
            Lo más visto en Paraná
          {% endif %}
        </h2>

        <div class="grilla-publicaciones">

          {% if publicaciones %}

            {% for pub in publicaciones %}

              <a href="/detalle/{{ pub.id }}" class="publicacion-card">

                {% if pub.imagen_url %}
                  <img src="{{ pub.imagen_url }}" alt="{{ pub.nombre }}" />
                {% else %}
                  <img src="/img/mate1.jpg" alt="{{ pub.nombre }}" />
                {% endif %}

                <div class="publicacion-info">
                  <p class="nombre-comercio">{{ pub.comercio }}</p>
                  <h3>{{ pub.nombre }}</h3>

                  {% if pub.precio %}
                    <p class="precio">$ {{ pub.precio }}</p>
                  {% endif %}

                  <p class="ubicacion">{{ pub.direccion_mostrar }}</p>
                </div>
              </a>

            {% endfor %}

          {% else %}

            <div class="panel-vacio">
              {% if busqueda and comercios_relacionados %}
                No encontramos publicaciones exactas para "{{ busqueda }}", pero abajo hay comercios relacionados por listas buscables.
              {% elif busqueda %}
                No encontramos publicaciones activas para "{{ busqueda }}". Probá con otra búsqueda.
              {% else %}
                Todavía no hay publicaciones cargadas. Entrá como comercio y cargá la primera.
              {% endif %}
            </div>

          {% endif %}

        </div>

      </div>
    </section>

    <!-- RESPUESTA DEL BUSCADOR POR LISTAS BUSCABLES -->
    {% if busqueda and comercios_relacionados %}
      <section class="seccion">
        <div class="contenedor">

          <div class="respuesta-buscador">
            <p class="titulo-chico">RESPUESTA DEL BUSCADOR</p>
            <h2 class="titulo-seccion">Comercios que podrían tener "{{ busqueda }}"</h2>
            <p>
              Encontramos comercios que mencionan esta búsqueda en sus listas buscables.
              Primero aparecen los Premium que coinciden, y después todos los demás comercios que también coinciden.
            </p>
          </div>

          <div class="grilla-comercios-lista">

            {% for item in comercios_relacionados %}

              <div class="comercio-lista-card {% if item.plan == 'premium' %}comercio-lista-premium{% endif %}">

                <div class="comercio-lista-top">
                  <div>
                    <p class="nombre-comercio">{{ item.nombre_negocio }}</p>
                    <h3>{{ item.producto_categoria }}</h3>
                  </div>

                  {% if item.plan == 'premium' %}
                    <span class="badge-premium">Premium</span>
                  {% endif %}
                </div>

                <div class="coincide-lista">
                  <p><strong>Coincide con:</strong> {{ item.atributos_texto or item.producto_categoria }}</p>
                  <p>La coincidencia viene de la lista buscable cargada por el comercio.</p>
                </div>

                <p class="ubicacion">{{ item.ubicacion_mostrar }}</p>

                <div class="acciones-lista">
                  <a href="/comercio/{{ item.comercio_id }}" class="boton-secundario">
                    Ver comercio
                  </a>

                  {% if item.whatsapp_url %}
                    <a href="{{ item.whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="boton-secundario">
                      Consultar por WhatsApp
                    </a>
                  {% endif %}
                </div>

              </div>

            {% endfor %}

          </div>

        </div>
      </section>
    {% endif %}
    <!-- FIN RESPUESTA DEL BUSCADOR POR LISTAS BUSCABLES -->




    <!-- PUBLICACIONES RECIENTES -->
    <section class="seccion">
      <div class="contenedor">

        <p class="titulo-chico">RECIENTES</p>
        <h2 class="titulo-seccion">Publicaciones recientes</h2>

        <div class="grilla-publicaciones">

          {% if publicaciones %}

            {% for pub in publicaciones %}

              <a href="/detalle/{{ pub.id }}" class="publicacion-card">

                {% if pub.imagen_url %}
                  <img src="{{ pub.imagen_url }}" alt="{{ pub.nombre }}" />
                {% else %}
                  <img src="/img/mate1.jpg" alt="{{ pub.nombre }}" />
                {% endif %}

                <div class="publicacion-info">
                  <p class="nombre-comercio">{{ pub.comercio }}</p>
                  <h3>{{ pub.nombre }}</h3>

                  {% if pub.precio %}
                    <p class="precio">$ {{ pub.precio }}</p>
                  {% endif %}

                  <p class="ubicacion">{{ pub.direccion_mostrar }}</p>
                </div>
              </a>

            {% endfor %}

          {% else %}

            <div class="panel-vacio">
              Todavía no hay publicaciones recientes.
            </div>

          {% endif %}

        </div>

      </div>
    </section>

  </main>


  <footer class="footer">
    <p>ClickLocal Paraná</p>
    <p>La forma más simple de mostrar y encontrar comercios locales.</p>
  </footer>

</body>
</html>

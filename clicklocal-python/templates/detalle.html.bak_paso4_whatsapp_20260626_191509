<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ publicacion.nombre }} | ClickLocal</title>
  <link rel="stylesheet" href="/styles.css" />
</head>

<body>

  <header class="header">
    <div class="header-contenedor">
      <div class="logo-zona">
        <div class="logo-circulo">C</div>

        <div>
          <h1 class="logo-texto">ClickLocal</h1>
          <p class="ciudad">📍 Paraná</p>
        </div>
      </div>

      <nav class="nav">
        <a href="/" class="nav-link">Inicio</a>
        <a href="/registro" class="boton-secundario">Soy comercio</a>
      </nav>
    </div>
  </header>


  <main class="detalle-main">

    <div class="detalle-contenedor">

      <a href="/" class="volver-link">← Volver a la plataforma</a>

      <section class="detalle-layout detalle-layout-simple">

        {% set ns = namespace(imagenes_detalle=[]) %}
        {% set portada = publicacion.imagen_principal or publicacion.imagen_url %}

        {% if portada %}
          {% set ns.imagenes_detalle = ns.imagenes_detalle + [portada] %}
        {% endif %}

        {% if publicacion.imagenes %}
          {% for img in publicacion.imagenes %}
            {% if img and img not in ns.imagenes_detalle %}
              {% set ns.imagenes_detalle = ns.imagenes_detalle + [img] %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if not ns.imagenes_detalle %}
          {% set ns.imagenes_detalle = ["/img/mate1.jpg"] %}
        {% endif %}


        <!-- MINIATURAS -->
        {% if ns.imagenes_detalle|length > 1 %}
          <aside class="detalle-miniaturas">
            {% for imagen in ns.imagenes_detalle %}
              <button
                class="miniatura{% if loop.first %} activa{% endif %}"
                type="button"
                data-imagen="{{ imagen }}"
                aria-label="Ver foto {{ loop.index }} de {{ publicacion.nombre }}"
              >
                <img src="{{ imagen }}" alt="{{ publicacion.nombre }} - foto {{ loop.index }}" />
              </button>
            {% endfor %}
          </aside>
        {% else %}
          <aside class="detalle-miniaturas" aria-hidden="true"></aside>
        {% endif %}


        <!-- FOTO GRANDE -->
        <section class="detalle-foto">
          <img
            id="detalle-imagen-principal"
            src="{{ ns.imagenes_detalle[0] }}"
            alt="{{ publicacion.nombre }}"
          />
        </section>


        <!-- INFO -->
        <aside class="detalle-info">

          <p class="detalle-ciudad">📍 {{ comercio.ciudad }}</p>

          <h1 class="detalle-titulo">{{ publicacion.nombre }}</h1>

          {% if publicacion.precio %}
            <p class="detalle-precio">$ {{ "{:,.0f}".format(publicacion.precio|float).replace(",", ".") }}</p>
          {% endif %}

          {% if publicacion.descripcion %}
            <p class="detalle-descripcion">
              {{ publicacion.descripcion }}
            </p>
          {% endif %}

          <div class="detalle-comercio">
            <p class="detalle-label">Comercio</p>
            <h2>{{ comercio.nombre_negocio }}</h2>
            <p>{{ comercio.direccion_mostrar }}</p>
          </div>

          <div class="detalle-botones">
            <a
              href="https://wa.me/54{{ comercio.whatsapp }}?text=Hola,%20vi%20esta%20publicación%20en%20ClickLocal%20y%20quiero%20consultar%20por:%20{{ publicacion.nombre }}"
              class="boton-whatsapp"
              target="_blank"
            >
              Consultar por WhatsApp
            </a>

            <a href="/perfil" class="boton-ver-comercio">
              Ver comercio
            </a>
          </div>

        </aside>

      </section>

    </div>

  </main>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const imagenPrincipal = document.getElementById("detalle-imagen-principal");
      const miniaturas = document.querySelectorAll(".detalle-miniaturas .miniatura");

      if (!imagenPrincipal || miniaturas.length === 0) {
        return;
      }

      miniaturas.forEach(function (boton) {
        boton.addEventListener("click", function () {
          const nuevaImagen = boton.getAttribute("data-imagen");

          if (!nuevaImagen) {
            return;
          }

          imagenPrincipal.src = nuevaImagen;

          miniaturas.forEach(function (otraMiniatura) {
            otraMiniatura.classList.remove("activa");
          });

          boton.classList.add("activa");
        });
      });
    });
  </script>

</body>
</html>
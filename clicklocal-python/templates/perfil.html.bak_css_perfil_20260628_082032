<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Deck Bazar | ClickLocal</title>
  <link rel="stylesheet" href="styles.css" />
</head>

<body>

  <header class="header">
    <div class="header-contenedor">
      <div class="logo-zona">
        <div class="logo-circulo">C</div>

        <div>
          <h1 class="logo-texto">ClickLocal</h1>
          <p class="ciudad">📍 Paraná</p>
        </div>
      </div>

      <nav class="nav">
        <a href="index.html" class="nav-link">Inicio</a>
        <a href="registro.html" class="boton-secundario">Soy comercio</a>
      </nav>
    </div>
  </header>


  <main class="perfil-main">

    <section class="perfil-contenedor">

      <a href="index.html" class="volver-link">← Volver a la plataforma</a>

      <!-- ENCABEZADO COMERCIO -->
      <section class="perfil-header-card">

        <div class="perfil-portada"></div>

        <div class="perfil-info-principal">

          <div class="perfil-logo">
            {{ comercio.iniciales }}
          </div>

          <div class="perfil-textos">
            <p class="titulo-chico">COMERCIO</p>
            <h1>{{ comercio.nombre_negocio }}</h1>
            <p class="perfil-rubro">{{ comercio.categoria or "Comercio local" }}</p>
            <p class="perfil-ubicacion">📍 {{ comercio.ubicacion_perfil }}</p>
          </div>

          <a href="{{ comercio.whatsapp_url or '#' }}" class="boton-whatsapp perfil-whatsapp">
            Consultar por WhatsApp
          </a>

        </div>

      </section>


      <!-- DESCRIPCIÓN -->
      <section class="perfil-bloque">
        <h2>Sobre el comercio</h2>
        <p>
          {{ comercio.descripcion or "Este comercio todavía no cargó una descripción." }}
        </p>
      </section>


      <!-- PUBLICACIONES -->
      <section class="perfil-bloque">
        <div class="perfil-bloque-header">
          <div>
            <p class="titulo-chico">VIDRIERA</p>
            <h2>Publicaciones de {{ comercio.nombre_negocio }}</h2>
          </div>
        </div>

        {% if publicaciones %}
        <div class="grilla-publicaciones perfil-grilla">

          {% for publicacion in publicaciones %}
          <a href="{{ url_for('detalle', publicacion_id=publicacion.id) }}" class="publicacion-card">
            <img src="{{ publicacion.imagen_url }}" alt="{{ publicacion.nombre }}" />

            <div class="publicacion-info">
              <p class="nombre-comercio">{{ comercio.nombre_negocio }}</p>
              <h3>{{ publicacion.nombre }}</h3>
              <p class="precio">{{ publicacion.precio_mostrar }}</p>
              <p class="ubicacion">{{ publicacion.ubicacion_mostrar }}</p>
            </div>
          </a>
          {% endfor %}

        </div>
        {% else %}
        <p>Este comercio todavía no tiene publicaciones activas.</p>
        {% endif %}
      </section>


      <!-- LISTAS BUSCABLES -->
      <section class="perfil-bloque">
        <div class="perfil-bloque-header">
          <div>
            <p class="titulo-chico">TAMBIÉN PODÉS ENCONTRAR</p>
            <h2>Listas buscables</h2>
          </div>
        </div>

        <div class="perfil-listas">

          <div class="perfil-lista-card">
            <h3>Mate</h3>
            <p>Imperial, camionero, acero, cuero, Stanley, térmico, silicona.</p>
          </div>

          <div class="perfil-lista-card">
            <h3>Botellas</h3>
            <p>Deportivas, térmicas, acero, plástico, litro, 750ml, colores.</p>
          </div>

          <div class="perfil-lista-card">
            <h3>Bazar</h3>
            <p>Vasos, platos, fuentes, recipientes, utensilios, regalos.</p>
          </div>

        </div>
      </section>

    </section>

  </main>

</body>
</html>
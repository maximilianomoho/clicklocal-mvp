<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panel comercio | ClickLocal</title>
  <link rel="stylesheet" href="/styles.css" />
</head>

<body>

  <header class="header">
    <div class="header-contenedor">
      <div class="logo-zona">
        <div class="logo-circulo">C</div>

        <div>
          <h1 class="logo-texto">ClickLocal</h1>
          <p class="ciudad">📍 Paraná</p>
        </div>
      </div>

      <nav class="nav">
        <a href="index.html" class="nav-link">Ir a la plataforma</a>
        <a href="login.html" class="boton-secundario">Salir</a>
      </nav>
    </div>
  </header>


  <main class="panel-main">

    <section class="panel-hero">
      <div>
        <p class="titulo-chico">MI COMERCIO</p>
        <h1>Hola, Deck Bazar</h1>
        <p>Administrá tus publicaciones, listas buscables y datos del comercio.</p>
      </div>

      <div class="panel-plan">
        <span>Plan actual</span>
        <strong>Gratis</strong>
      </div>
    </section>


    <section class="panel-layout">

      <!-- COLUMNA IZQUIERDA -->
      <aside class="panel-menu">
        <a href="#publicacion" class="panel-menu-link activo">Cargar publicación</a>
        <a href="#mis-publicaciones" class="panel-menu-link">Mis publicaciones</a>
        <a href="#listas" class="panel-menu-link">Listas buscables</a>
        <a href="#datos" class="panel-menu-link">Mis datos</a>
        <a href="#plan" class="panel-menu-link">Mi plan</a>
      </aside>


      <!-- COLUMNA PRINCIPAL -->
      <section class="panel-contenido">

        <!-- CARGAR PUBLICACIÓN -->
        <article id="publicacion" class="panel-card">
          <div class="panel-card-header">
            <div>
              <p class="titulo-chico">PUBLICACIONES</p>
              <h2>Cargar publicación</h2>
            </div>
            <span class="badge">Hasta 6 fotos</span>
          </div>

          <div class="fotos-grid">
            <button type="button" class="foto-box" data-foto-slot="0">+<span>Principal</span></button>
            <button type="button" class="foto-box" data-foto-slot="1">+<span>Principal</span></button>
            <button type="button" class="foto-box" data-foto-slot="2">+<span>Principal</span></button>
            <button type="button" class="foto-box" data-foto-slot="3">+<span>Principal</span></button>
            <button type="button" class="foto-box" data-foto-slot="4">+<span>Principal</span></button>
            <button type="button" class="foto-box" data-foto-slot="5">+<span>Principal</span></button>
          </div>

          <form class="formulario panel-form" method="POST" action="/panel" enctype="multipart/form-data">
            <input type="hidden" name="foto_principal" id="foto_principal" value="0">
            <input type="file" name="foto_0" id="foto_0" accept="image/*" hidden>
            <input type="file" name="foto_1" id="foto_1" accept="image/*" hidden>
            <input type="file" name="foto_2" id="foto_2" accept="image/*" hidden>
            <input type="file" name="foto_3" id="foto_3" accept="image/*" hidden>
            <input type="file" name="foto_4" id="foto_4" accept="image/*" hidden>
            <input type="file" name="foto_5" id="foto_5" accept="image/*" hidden>

            <div class="campo">
              <label>Nombre de la publicación *</label>
              <input type="text" name="nombre_publicacion" placeholder="Ej: Equipo de mate imperial" />
            </div>

            <div class="campo">
              <label>Precio</label>
              <input type="text" name="precio" placeholder="Ej: 42000" />
            </div>

            <div class="campo">
              <label>Descripción</label>
              <textarea name="descripcion_publicacion" placeholder="Descripción visible en el detalle de la publicación."></textarea>
            </div>

            <label class="checkbox-linea">
              <input type="checkbox" name="activa" checked />
              <span>Publicación activa</span>
            </label>

            <button type="submit" class="boton-principal-form">
              Publicar
            </button>

          </form>
        </article>


        <!-- MIS PUBLICACIONES -->
        <article id="mis-publicaciones" class="panel-card">
          <div class="panel-card-header">
            <div>
              <p class="titulo-chico">VIDRIERA</p>
              <h2>Mis publicaciones</h2>
            </div>
          </div>

          <div class="panel-publicaciones-lista">

            {% if publicaciones %}
              {% for pub in publicaciones %}

                {% set foto_portada = pub.imagen_principal or pub.imagen_url or (pub.imagenes[0] if pub.imagenes else '') %}

                <div class="panel-publicacion-item">
                  {% if foto_portada %}
                    <img src="{{ foto_portada }}" alt="{{ pub.nombre }}" />
                  {% else %}
                    <img src="img/mate1.jpg" alt="{{ pub.nombre }}" />
                  {% endif %}

                  <div>
                    <h3>{{ pub.nombre }}</h3>

                    <p class="panel-descripcion">
                      {{ pub.descripcion or "Sin descripción." }}
                    </p>

                    {% if pub.precio %}
                      <p class="precio">$ {{ pub.precio|int }}</p>
                    {% endif %}

                    {% if pub.activa %}
                      <span class="estado-activo">Activa</span>
                    {% else %}
                      <span class="estado-activo">Pausada</span>
                    {% endif %}
                  </div>

                  <div class="acciones-publicacion">
                    <button type="button">Editar</button>
                    <button type="button">Pausar</button>
                  </div>
                </div>

              {% endfor %}
            {% else %}
              <p class="panel-descripcion">
                Todavía no cargaste publicaciones.
              </p>
            {% endif %}

          </div>
        </article>


        <!-- LISTAS BUSCABLES -->
        <article id="listas" class="panel-card">
          <div class="panel-card-header">
            <div>
              <p class="titulo-chico">BUSCADOR</p>
              <h2>Listas buscables</h2>
            </div>
          </div>

          <form class="formulario panel-form">
            <div class="campo">
              <label>Producto o categoría</label>
              <input type="text" placeholder="Ej: Mate" />
            </div>

            <div class="campo">
              <label>Atributos o variantes</label>
              <textarea placeholder="Imperial, acero, cuero, camionero, Stanley, térmico"></textarea>
            </div>

            <button type="button" class="boton-principal-form">
              Guardar lista buscable
            </button>
          </form>

          <div class="lista-ejemplo">
            <strong>Mate</strong>
            <p>Imperial, acero, cuero, camionero, Stanley, térmico</p>
            <button>Editar</button>
          </div>
        </article>


        <!-- MIS DATOS -->
        <article id="datos" class="panel-card">
          <div class="panel-card-header">
            <div>
              <p class="titulo-chico">COMERCIO</p>
              <h2>Mis datos</h2>
            </div>
          </div>

          <form class="formulario panel-form">
            <div class="campo">
              <label>Nombre del comercio</label>
              <input type="text" value="Deck Bazar" />
            </div>

            <div class="campo">
              <label>WhatsApp</label>
              <input type="text" value="3430000000" />
            </div>

            <div class="campo">
              <label>Dirección</label>
              <input type="text" value="Venta Online" />
            </div>

            <div class="campo">
              <label>Descripción breve</label>
              <textarea>Bazar, regalos, mates y productos para el hogar.</textarea>
            </div>

            <button type="button" class="boton-principal-form">
              Guardar cambios
            </button>
          </form>
        </article>


        <!-- MI PLAN -->
        <article id="plan" class="panel-card">
          <div class="panel-card-header">
            <div>
              <p class="titulo-chico">PREMIUM</p>
              <h2>Mi plan</h2>
            </div>
          </div>

          <div class="plan-box">
            <div>
              <span>Plan actual</span>
              <h3>Gratis</h3>
              <p>Tu comercio aparece en ClickLocal. Podés cargar publicaciones y listas buscables.</p>
            </div>

            <a href="#" class="boton-whatsapp">
              Quiero ser Premium
            </a>
          </div>
        </article>

      </section>

    </section>

  </main>


  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const fotoPrincipalInput = document.getElementById("foto_principal");
      const botonesFoto = document.querySelectorAll(".foto-box[data-foto-slot]");
      const previewUrls = {};

      function tieneFoto(slot) {
        const inputFoto = document.getElementById("foto_" + slot);
        return inputFoto && inputFoto.files && inputFoto.files.length > 0;
      }

      function mostrarPreview(slot) {
        const inputFoto = document.getElementById("foto_" + slot);
        const boton = document.querySelector('.foto-box[data-foto-slot="' + slot + '"]');

        if (!inputFoto || !boton || !inputFoto.files || inputFoto.files.length === 0) {
          return;
        }

        if (previewUrls[slot]) {
          URL.revokeObjectURL(previewUrls[slot]);
        }

        previewUrls[slot] = URL.createObjectURL(inputFoto.files[0]);
        boton.style.backgroundImage = 'url("' + previewUrls[slot] + '")';
        boton.classList.add("tiene-foto");
      }

      function pintarPrincipal(slotPrincipal) {
        botonesFoto.forEach(function (boton) {
          const span = boton.querySelector("span");
          const slot = boton.dataset.fotoSlot;
          const fotoCargada = tieneFoto(slot);
          const estaElegida = fotoCargada && slot === slotPrincipal;

          boton.classList.toggle("tiene-foto", fotoCargada);
          boton.classList.toggle("es-principal", estaElegida);

          if (!fotoCargada) {
            boton.style.backgroundImage = "";
          }

          if (span) {
            if (!fotoCargada) {
              span.textContent = "Agregar foto";
            } else if (estaElegida) {
              span.textContent = "PORTADA";
            } else {
              span.textContent = "poner de portada";
            }
          }
        });
      }

      botonesFoto.forEach(function (boton) {
        boton.addEventListener("click", function (event) {
          const slot = boton.dataset.fotoSlot;
          const inputFoto = document.getElementById("foto_" + slot);
          const clicEnFranja = event.target && event.target.tagName === "SPAN";

          if (clicEnFranja && tieneFoto(slot)) {
            if (fotoPrincipalInput) {
              fotoPrincipalInput.value = slot;
            }

            pintarPrincipal(slot);
            return;
          }

          if (inputFoto) {
            inputFoto.click();
          }
        });
      });

      for (let i = 0; i < 6; i++) {
        const inputFoto = document.getElementById("foto_" + i);

        if (inputFoto) {
          inputFoto.addEventListener("change", function () {
            if (inputFoto.files && inputFoto.files.length > 0) {
              mostrarPreview(String(i));

              if (fotoPrincipalInput) {
                fotoPrincipalInput.value = String(i);
              }

              pintarPrincipal(String(i));
            }
          });
        }
      }

      pintarPrincipal(fotoPrincipalInput ? fotoPrincipalInput.value : "0");
    });
  </script>

</body>
</html>
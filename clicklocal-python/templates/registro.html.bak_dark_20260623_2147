<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quiero publicar | ClickLocal</title>
  <link rel="stylesheet" href="styles.css" />
</head>

<body>

  <header class="header">
    <div class="header-contenedor">
      <div class="logo-zona">
        <div class="logo-circulo">C</div>

        <div>
          <h1 class="logo-texto">ClickLocal</h1>
          <p class="ciudad">📍 Paraná</p>
        </div>
      </div>

      <nav class="nav">
        <a href="index.html" class="nav-link">Inicio</a>
        <a href="login.html" class="boton-secundario">Iniciar sesión</a>
      </nav>
    </div>
  </header>


  <main class="auth-main">

    <section class="auth-card registro-card">

      <div class="auth-encabezado">
        <p class="titulo-chico">SOY COMERCIO</p>
        <h1>Quiero publicar mi comercio</h1>
        <p>
          Creá tu cuenta y empezá a mostrar tus productos, servicios o listas buscables en ClickLocal.
        </p>
      </div>

      {% if error %}
        <div class="alerta-error">
          {{ error }}
        </div>

      {% endif %}
      <form class="formulario" method="POST" action="/registro">

        <div class="campo">
          <label>Nombre del negocio *</label>
          <input type="text" name="nombre_negocio" placeholder="Ej: Deck Bazar" />
        </div>

        <div class="campo">
          <label>Email *</label>
          <input type="email" name="email" placeholder="tunegocio@email.com" />
        </div>

        <div class="campo">
          <label>WhatsApp *</label>
          <input type="tel" name="whatsapp" placeholder="Ej: 343 000 0000" />
        </div>

        <div class="campo">
          <label>Dirección</label>
          <input type="text" name="direccion" placeholder="Ej: Av. Ramírez 1234" />
        </div>

        <label class="checkbox-linea">
          <input type="checkbox" name="venta_online" />
          <span>Vendo online o coordino por WhatsApp</span>
        </label>

        <div class="campo">
          <label>Ciudad</label>
          <input type="text" name="ciudad" value="Paraná" />
        </div>

        <div class="campo">
          <label>Rubro o categoría</label>
          <select name="categoria">
            <option>Seleccionar categoría</option>
            <option>Gastronomía</option>
            <option>Indumentaria</option>
            <option>Hogar</option>
            <option>Tecnología</option>
            <option>Salud</option>
            <option>Servicios</option>
            <option>Deportes</option>
            <option>Educación y Cursos</option>
          </select>
        </div>

        <div class="campo">
          <label>Descripción breve</label>
          <textarea name="descripcion" placeholder="Contá en pocas palabras qué vendés o qué servicio ofrecés."></textarea>
        </div>

        <div class="form-doble">
          <div class="campo">
            <label>Contraseña *</label>
            <input type="password" name="password" placeholder="Mínimo 6 caracteres" />
          </div>

          <div class="campo">
            <label>Repetir contraseña *</label>
            <input type="password" name="repetir_password" placeholder="Repetir contraseña" />
          </div>
        </div>

        <button type="submit" class="boton-principal-form">
          Crear cuenta
        </button>

        <p class="auth-ayuda">
          ¿Ya tenés cuenta?
          <a href="login.html">Iniciar sesión</a>
        </p>

      </form>

    </section>

  </main>

</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Panel de control | ClickLocal</title>
  <link rel="stylesheet" href="/styles.css" />

  <style>
    .admin-tabla-contenedor {
      width: 100%;
      overflow-x: auto;
      background: #fff;
      border-radius: 16px;
      padding: 16px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .admin-tabla {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
    }

    .admin-tabla th,
    .admin-tabla td {
      padding: 12px;
      border-bottom: 1px solid #eee;
      text-align: left;
      vertical-align: middle;
      font-size: 14px;
    }

    .admin-tabla th {
      font-weight: 700;
      color: #333;
      background: #fafafa;
    }

    .admin-plan {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      background: #eef2ff;
      font-size: 13px;
      font-weight: 600;
    }

    .admin-error {
      background: #ffe5e5;
      color: #8a0000;
      padding: 14px;
      border-radius: 12px;
      margin-bottom: 18px;
    }

    .admin-vacio {
      padding: 24px;
      background: #fff;
      border-radius: 16px;
      text-align: center;
    }

    .admin-mini-link {
      font-weight: 600;
      text-decoration: none;
    }

    @media (max-width: 768px) {
      .admin-main {
        padding: 16px;
      }

      .admin-resumen {
        grid-template-columns: 1fr;
      }

      .admin-hero h1 {
        font-size: 28px;
      }
    }
  </style>
</head>

<body>

  <header class="header">
    <div class="header-contenedor">
      <div class="logo-zona">
        <div class="logo-circulo">C</div>

        <div>
          <h1 class="logo-texto">ClickLocal</h1>
          <p class="ciudad">Panel de control</p>
        </div>
      </div>

      <nav class="nav">
        <a href="/index.html" class="nav-link">Ir a la plataforma</a>
        <a href="/admin/logout" class="boton-secundario">Salir</a>
      </nav>
    </div>
  </header>

  <main class="admin-main">

    <section class="admin-hero">
      <div>
        <p class="titulo-chico">ADMINISTRACIÓN</p>
        <h1>Panel de control</h1>
        <p>Vista interna con datos reales de comercios y publicaciones.</p>

        {% if admin_user %}
          <p style="margin-top: 8px; font-size: 14px;">Sesión admin: {{ admin_user }}</p>
        {% endif %}
      </div>
    </section>

    {% if error %}
      <div class="admin-error">
        {{ error }}
      </div>
    {% endif %}

    <section class="admin-resumen">

      <div class="admin-resumen-card">
        <span>Comercios</span>
        <strong>{{ resumen.total_comercios }}</strong>
        <p>Registrados</p>
      </div>

      <div class="admin-resumen-card">
        <span>Premium</span>
        <strong>{{ resumen.total_premium }}</strong>
        <p>Activos</p>
      </div>

      <div class="admin-resumen-card">
        <span>Publicaciones</span>
        <strong>{{ resumen.total_publicaciones }}</strong>
        <p>Totales</p>
      </div>

      <div class="admin-resumen-card alerta">
        <span>Solicitudes</span>
        <strong>{{ resumen.total_solicitudes_premium }}</strong>
        <p>Premium pendientes</p>
      </div>

    </section>

    <section class="admin-layout" style="display:block; margin-bottom: 24px;">

      <article class="admin-card">
        <div class="admin-card-header">
          <div>
            <p class="titulo-chico">PREMIUM</p>
            <h2>Solicitudes Premium pendientes</h2>
          </div>
        </div>

        {% if solicitudes_premium %}
          <div class="admin-tabla-contenedor">
            <table class="admin-tabla">
              <thead>
                <tr>
                  <th>Comercio</th>
                  <th>WhatsApp</th>
                  <th>Email</th>
                  <th>Plan actual</th>
                  <th>Estado</th>
                  <th>Acción</th>
                </tr>
              </thead>

              <tbody>
                {% for s in solicitudes_premium %}
                  <tr>
                    <td><strong>{{ s.nombre }}</strong></td>
                    <td>{{ s.whatsapp }}</td>
                    <td>{{ s.email }}</td>
                    <td><span class="admin-plan">{{ s.plan }}</span></td>
                    <td><span class="admin-plan">Pendiente</span></td>
                    <td>
                      {% if s.whatsapp_url %}
                        <a class="admin-mini-link" href="{{ s.whatsapp_url }}" target="_blank">Contactar</a>
                      {% else %}
                        Sin WhatsApp
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="admin-vacio">
            No hay solicitudes Premium pendientes.
          </div>
        {% endif %}

      </article>

    </section>

    <section class="admin-layout" style="display:block;">

      <article class="admin-card">
        <div class="admin-card-header">
          <div>
            <p class="titulo-chico">COMERCIOS</p>
            <h2>Comercios registrados</h2>
          </div>
        </div>

        {% if comercios %}
          <div class="admin-tabla-contenedor">
            <table class="admin-tabla">
              <thead>
                <tr>
                  <th>Comercio</th>
                  <th>Email</th>
                  <th>WhatsApp</th>
                  <th>Ciudad</th>
                  <th>Categoría</th>
                  <th>Plan</th>
                  <th>Publicaciones</th>
                  <th>Activas</th>
                  <th>Perfil</th>
                </tr>
              </thead>

              <tbody>
                {% for c in comercios %}
                  <tr>
                    <td><strong>{{ c.nombre }}</strong></td>
                    <td>{{ c.email }}</td>
                    <td>{{ c.whatsapp }}</td>
                    <td>{{ c.ciudad }}</td>
                    <td>{{ c.categoria }}</td>
                    <td><span class="admin-plan">{{ c.plan }}</span></td>
                    <td>{{ c.publicaciones_total }}</td>
                    <td>{{ c.publicaciones_activas }}</td>
                    <td>
                      {% if c.perfil_url %}
                        <a class="admin-mini-link" href="{{ c.perfil_url }}" target="_blank">Ver</a>
                      {% else %}
                        -
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="admin-vacio">
            Todavía no hay comercios registrados.
          </div>
        {% endif %}

      </article>

    </section>

  </main>

</body>
</html>
